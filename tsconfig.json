{
    "compilerOptions": {
        "checkJs": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "downlevelIteration": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "outDir": "dist"
    },
    "include": ["src/**/*", "**/*.js"]
}
