{
    "compilerOptions": {
        "checkJs": true,
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "useDefineForClassFields": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "outDir": "dist"
    },
    "include": ["src/**/*", "**/*.js"]
}
