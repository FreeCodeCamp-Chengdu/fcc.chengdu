{
    "name": "fcc-web",
    "version": "1.0.0",
    "private": true,
    "dependencies": {
        "classnames": "^2.5.1",
        "idea-react": "^3.0.0-beta.5",
        "mobx": "^7.1.5",
        "mobx-react": "^10.0.3",
        "react": "^19.3.1",
        "react-chrono": "^3.3.3",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "web-utility": "^4.8.1"
    },
    "scripts": {
        "prepare": "husky || true",
        "install": "tsx tool/test tool/event.txt",
        "test": "lint-staged  &&  tsc --noEmit",
        "clean": "rimraf .parcel-cache/ dist/",
        "start": "npm run clean  &&  parcel public/index.html",
        "pack": "npm run clean  &&  parcel build public/index.html --no-scope-hoist --public-url .",
        "build": "npm run pack  &&  workbox generateSW"
    },
    "fcc": {
        "name": "fcc.chengdu",
        "type": "react",
        "root": "./build",
        "publicUrl": "https://fcc-cd.dev/fcc.chengdu/"
    },
    "devDependencies": {
        "@parcel/config-default": "~2.16.4",
        "@parcel/packager-raw-url": "~2.16.4",
        "@parcel/transformer-less": "~2.16.4",
        "@parcel/transformer-typescript-tsc": "~2.16.4",
        "@parcel/transformer-webmanifest": "~2.16.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "buffer": "^6.0.3",
        "husky": "^9.1.7",
        "less": "^4.9.1",
        "lint-staged": "^17.6.0",
        "parcel": "~2.16.4",
        "prettier": "^3.9.10",
        "process": "^0.11.10",
        "rimraf": "^6.1.4",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "workbox-cli": "^7.4.1"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4,
        "printWidth": 100,
        "overrides": [
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "lint-staged": {
        "*.{html,md,less,json,yml,js,jsx,ts,tsx}": "prettier --write"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead",
    "@parcel/resolver-default": {
        "packageExports": true
    }
}
